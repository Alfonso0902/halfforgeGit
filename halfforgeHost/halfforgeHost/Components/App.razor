@code {
    private bool showModal = false;
    private bool isSuccess = false;

    [SupplyParameterFromForm]
    public SendEmailModel model { get; set; } = new();
                                
    [Inject]
    private EmailService EmailService { get; set; } = default!;
                                
   private async Task SendEmail()
    {
        try
        {
            await EmailService.SendAsync(
                model.Email,
                $"Messaggio da {model.Name}",
                model.Message
            );

            isSuccess = true;
            showModal = true;

            model = new(); // reset form
        }
        catch
        {
            isSuccess = false;
            showModal = true;
        }
    }
    private void CloseModal()
    {
        showModal = false;
    }

}

